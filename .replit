modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["sqlite", "ghostscript", "openssl"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f 'node server.js' 2>/dev/null; sleep 1; node server.js"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5599
externalPort = 3000

[deployment]
deploymentTarget = "vm"
# ── TEMPORAL · R01 · dry-run del cifrado ─────────────────────────────────────
# Cuenta en qué formato está cada secreto guardado y ARRANCA EL SERVIDOR. En seco:
# no escribe, no crea la tabla de copia y no toca ningún ciphertext (solo emite tres
# SELECT). El `;` en vez de `&&` es deliberado: pase lo que pase con el recuento, el
# servidor arranca. El `timeout` cubre el único caso que el `;` no cubre — que el
# recuento se quede colgado esperando a la base y el servidor no llegue a arrancar nunca.
# REVERTIR a `run = ["node", "server.js"]` en cuanto se lean los conteos.
run = ["sh", "-c", "timeout 120 node scripts/migrar-cifrado.js --dry-run; node server.js"]
