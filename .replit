modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["sqlite", "ghostscript", "openssl"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f 'node server.js' 2>/dev/null; sleep 1; node server.js"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5599
externalPort = 3000

[deployment]
deploymentTarget = "vm"
# ── TEMPORAL · R01 · MIGRACIÓN REAL, UNA SOLA VEZ ───────────────────────────
# El dry-run del 9/9 contó 7 valores en formato legado y 0 ilegibles. Esto los pasa a v2.
#
# Una transacción, con candado, copia previa de los criptogramas en `cifrado_copia_v1` y
# relectura de cada valor nuevo antes de confirmar. Si algo falla, ROLLBACK completo y la
# base se queda como está, que es un estado que funciona.
#
# Es IDEMPOTENTE: si el deployment se reinicia solo, la segunda pasada encuentra todo en v2,
# no reescribe nada y no pisa la copia. El `;` en vez de `&&` mantiene el servidor arrancando
# pase lo que pase con la migración; el `timeout` cubre que se quede colgada (si salta, la
# conexión muere y PostgreSQL deshace la transacción).
#
# REVERTIR a `run = ["node", "server.js"]` en cuanto se verifiquen los conteos.
run = ["sh", "-c", "timeout 120 node scripts/migrar-cifrado.js --aplicar --si-estoy-seguro; node server.js"]
